# Kopiere diese Datei nach `.env` und passe die Werte an.
DATABASE_URL="postgresql://postgres:postgres@db:5432/timetracker?schema=public"
# Direkte Verbindung nur für `prisma migrate`. Lokal = DATABASE_URL;
# bei Neon die „Direct"-URL (ohne -pooler). Siehe VERCEL.md.
DIRECT_URL="postgresql://postgres:postgres@db:5432/timetracker?schema=public"
AUTH_SECRET="<openssl rand -base64 32>"
AUTH_TRUST_HOST="true"
APP_TIMEZONE="Europe/Berlin"

# Optional: echte Zugverbindungen im Reiseplaner (Google Directions API, Transit-Modus).
# Ohne Key bleibt das Zug-Feature inaktiv (Endpoint /api/v1/geo/transit → 503).
GOOGLE_MAPS_API_KEY=""
# Beleg-Scan (OCR). Eigener Key, NICHT der Maps-Key: nur dieser Dienst kann bei
# einem Fehler wirklich Geld kosten, deshalb einzeln widerrufbar. Gratis bis
# 1.000 Bilder/Monat. Muss im Projekt auf "Cloud Vision API" freigegeben sein.
GOOGLE_VISION_API_KEY=""
# vision | claude | auto (Default: erst Vision, bei Fehlschlag Claude)
# RECEIPT_ENGINE=""

# Optional: automatischer Flug-Abruf per Flugnummer (AeroDataBox über RapidAPI).
# Ohne Key bleibt der Auto-Abruf inaktiv (Endpoint /api/v1/flights/lookup → 422),
# Flüge lassen sich dann manuell erfassen.
AERODATABOX_API_KEY=""

# Passkeys/WebAuthn (Fingerabdruck-Login). Defaults passen für lokale Entwicklung.
# Für Produktion auf die echte HTTPS-Domain setzen (rp_id = Hostname ohne Schema/Port).
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_NAME="Time Tracker"

# Optional: E-Mail-Versand für Reise-Einladungen (SMTP). Ohne SMTP_HOST wird das
# Mitglied trotzdem hinzugefügt, nur ohne E-Mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CloverJapanPlaner <no-reply@deine-domain>"
APP_URL="https://app.deine-domain.de"
