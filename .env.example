# Kopiere diese Datei nach `.env` und passe die Werte an.
DATABASE_URL="postgresql://postgres:postgres@db:5432/timetracker?schema=public"
# Direkte Verbindung nur für `prisma migrate`. Lokal = DATABASE_URL;
# bei Neon die „Direct"-URL (ohne -pooler). Siehe VERCEL.md.
DIRECT_URL="postgresql://postgres:postgres@db:5432/timetracker?schema=public"
AUTH_SECRET="<openssl rand -base64 32>"
AUTH_TRUST_HOST="true"

# Optional: echte Zugverbindungen im Reiseplaner (Google Directions API, Transit-Modus).
# Ohne Key bleibt das Zug-Feature inaktiv (Endpoint /api/v1/geo/transit → 503).
GOOGLE_MAPS_API_KEY=""
# Beleg-Scan (OCR). Eigener Key, NICHT der Maps-Key: nur dieser Dienst kann bei
# einem Fehler wirklich Geld kosten, deshalb einzeln widerrufbar. Gratis bis
# 1.000 Bilder/Monat. Muss im Projekt auf "Cloud Vision API" freigegeben sein.
GOOGLE_VISION_API_KEY=""
# Obergrenze der Scans pro KALENDERMONAT ueber alle Nutzer (Default 950 von
# 1.000 gratis). Ueber dem Freikontingent rechnet Google ab — das hier ist die
# einzige Bremse in der App. Zusaetzlich ein Budget-Alarm in der Google Cloud.
# VISION_MONTHLY_LIMIT="950"

# Optional: automatischer Flug-Abruf per Flugnummer (AeroDataBox über RapidAPI).
# Ohne Key bleibt der Auto-Abruf inaktiv (Endpoint /api/v1/flights/lookup → 422),
# Flüge lassen sich dann manuell erfassen.
AERODATABOX_API_KEY=""
# Obergrenze der AeroDataBox-Aufrufe pro KALENDERMONAT über alle Wege (Oberfläche
# UND Flug-Status-Cron). Der kostenlose RapidAPI-Tarif liegt im Bereich einiger
# hundert Aufrufe; was darüber liegt, kostet. Hin- und Rückflug brauchen mit der
# gestaffelten Prüfung rund 200. Default 400 — wer sein Kontingent kennt, darf höher.
# FLIGHT_MONTHLY_LIMIT="400"

# Passkeys/WebAuthn (Fingerabdruck-Login). Defaults passen für lokale Entwicklung.
# Für Produktion auf die echte HTTPS-Domain setzen (rp_id = Hostname ohne Schema/Port).
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_NAME="Time Tracker"

# Optional: E-Mail-Versand für Reise-Einladungen (SMTP). Ohne SMTP_HOST wird das
# Mitglied trotzdem hinzugefügt, nur ohne E-Mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CloverJapanPlaner <no-reply@deine-domain>"
APP_URL="https://app.deine-domain.de"

# Optional: Web-Push (Team-Benachrichtigungen bei neuen Aktivitäten).
# Schlüsselpaar einmalig erzeugen:
#   docker compose run --rm app npx web-push generate-vapid-keys
# ⚠️ Fehlen die Keys, tut der Schalter im Profil scheinbar etwas, aber es wird
# NIE eine Benachrichtigung verschickt (`pushConfigured()` → false). In
# Produktion also in Vercel unter Environment Variables setzen.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:du@deine-domain.de"

# Empfohlen: schützt den täglichen Aufräum-Job /api/v1/cron/cleanup (Vercel-Cron).
# ⚠️ Ohne Secret ist der Endpunkt gesperrt — dann räumt NIEMAND auf und die
# Tabellen RateLimit/Token/WebauthnChallenge wachsen unbegrenzt weiter.
CRON_SECRET=""

# Optional: zusätzliche Discord-Nachricht, wenn jemand einen Koffer findet.
DISCORD_WEBHOOK_URL=""

# Nur hinter einem eigenen Reverse-Proxy: wie viele vertrauenswürdige Hops am
# RECHTEN Ende von X-Forwarded-For stehen. Ohne diesen Wert wird die IP nur aus
# Vercel-/Cloudflare-Headern gelesen — der erste XFF-Eintrag ist frei fälschbar
# und taugt nie als Grundlage fürs Rate-Limit.
# TRUSTED_PROXY_HOPS="1"

# ── Karte ────────────────────────────────────────────────────────────────
# CARTO verlangt seit August 2026 einen Schluessel fuer seine Raster-Kacheln.
# OHNE Key liefert der Dienst weiterhin HTTP 200 — aber ein Platzhalterbild mit
# dem Aufdruck "API KEY REQUIRED". Es gibt also keinen Fehler, die Karte sieht
# nur leer aus. Die App faellt dann auf OpenStreetMap zurueck; dort ist das
# Offline-Vorladen gesperrt (die OSM-Nutzungsbedingungen untersagen Massen-
# Abrufe), die Karte selbst funktioniert normal.
# Kostenlos, ohne Konto und ohne Zahlungsmittel: https://carto.com/basemaps/apikey
# 5 Mio. Kachel-Abrufe/Monat (nicht-kommerziell) — unerreichbar fuer eine Reise.
CARTO_API_KEY=""
