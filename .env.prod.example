# ─────────────────────────────────────────────────────────────────────────
#  Produktions-Umgebung (Self-Hosting). Kopieren nach `.env.prod` und ausfüllen.
#  Start:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#  WICHTIG: .env.prod niemals committen (steht in .gitignore / .dockerignore).
# ─────────────────────────────────────────────────────────────────────────

# ── Datenbank (lokaler Postgres-Container) ───────────────────────────────
POSTGRES_USER="clover"
POSTGRES_PASSWORD="BITTE-STARKES-PASSWORT-SETZEN"
POSTGRES_DB="clover"
# Muss zu den POSTGRES_*-Werten passen; Host = Service-Name "db".
DATABASE_URL="postgresql://clover:BITTE-STARKES-PASSWORT-SETZEN@db:5432/clover?schema=public"
DIRECT_URL="postgresql://clover:BITTE-STARKES-PASSWORT-SETZEN@db:5432/clover?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────
# Erzeugen mit:  openssl rand -base64 32
AUTH_SECRET="BITTE-GENERIEREN"
# Hinter Cloudflare Tunnel läuft die App hinter einem Proxy → true.
AUTH_TRUST_HOST="true"

# ── App ──────────────────────────────────────────────────────────────────
# Die öffentliche HTTPS-Adresse (dein Cloudflare-Public-Hostname).
APP_URL="https://clover.deine-domain.de"

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
# Token aus Zero-Trust → Networks → Tunnels → (Tunnel) → Docker-Connector.
TUNNEL_TOKEN="BITTE-EINSETZEN"

# ── Passkeys / WebAuthn (brauchen HTTPS) ──────────────────────────────────
# RP_ID = reiner Hostname OHNE Schema/Port; ORIGIN = volle HTTPS-URL.
WEBAUTHN_RP_ID="clover.deine-domain.de"
WEBAUTHN_ORIGIN="https://clover.deine-domain.de"
WEBAUTHN_RP_NAME="Clover Japan"

# ── Web-Push (Team-Benachrichtigungen; brauchen HTTPS) ────────────────────
# Schlüsselpaar erzeugen mit:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:du@deine-domain.de"

# ── Optional: E-Mail (Einladungen/Verify/Reset/Koffer-Fund) ──────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Clover Japan <no-reply@deine-domain.de>"

# ── Optional: externe Dienste (ohne Key sauberer Fallback, kein Crash) ────
# Flüge (Auto-Abruf + Live-Status) via AeroDataBox/RapidAPI:
AERODATABOX_API_KEY=""
# Beleg-Scan: Google Cloud Vision (OCR, gratis bis 1.000 Bilder/Monat).
# Eigener Key im selben GCP-Projekt wie GOOGLE_MAPS_API_KEY, aber getrennt:
# nur dieser Dienst kann bei einem Fehler Geld kosten -> einzeln widerrufbar.
# Voraussetzung: "Cloud Vision API" im Projekt aktiviert, Key darauf beschränkt,
# KEINE IP-/Referrer-Beschränkung (Vercel ruft mit wechselnden IPs auf).
# Ohne Key: 422, Betrag wird manuell eingetragen.
GOOGLE_VISION_API_KEY=""
# Obergrenze der Scans pro KALENDERMONAT ueber alle Nutzer (Default 950 von
# 1.000 gratis). Ueber dem Freikontingent rechnet Google ab — das hier ist die
# einzige Bremse in der App. Zusaetzlich ein Budget-Alarm in der Google Cloud.
# VISION_MONTHLY_LIMIT="950"
# Echte Zugverbindung + exakte Konbini-Filiale (Places-IDs = kostenlos):
GOOGLE_MAPS_API_KEY=""
# Discord-Push bei Koffer-Fund:
DISCORD_WEBHOOK_URL=""

# Flug-Status-Abfragen pro KALENDERMONAT ueber alle Wege (Default 400).
# AeroDataBox laeuft ueber RapidAPI mit Monatskontingent; darueber wird
# abgerechnet oder gesperrt. Hin- und Rueckflug brauchen rund 200.
# FLIGHT_MONTHLY_LIMIT="400"

# ── Cron ──────────────────────────────────────────────────────────────────
# Schuetzt /api/v1/cron/cleanup UND /api/v1/cron/flight-status. Ohne Secret
# sind beide gesperrt: RateLimit-/Token-/Challenge-Zeilen wachsen unbegrenzt,
# und es gibt keine Push-Meldung bei Gate- oder Verspaetungsaenderung.
#   openssl rand -base64 32
CRON_SECRET=""
# Takt des cron-Containers in Sekunden (Default 900 = 15 min). Der Endpunkt
# entscheidet per `isCheckDue` selbst, ob ein Flug wirklich abgefragt wird —
# haeufiges Klopfen kostet also nichts.
# CRON_INTERVAL_SECONDS="900"
# Stunde (UTC), ab der das naechtliche Aufraeumen einmal am Tag laeuft.
# CRON_CLEANUP_HOUR="4"
