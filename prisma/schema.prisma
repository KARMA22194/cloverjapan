// Prisma-Schema für den Time Tracker.
// Datenmodell laut Plan: User / Project / Assignment / TimeEntry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Laufzeit-Verbindung der App (bei Neon: die „Pooled"-URL).
  url      = env("DATABASE_URL")
  // Direkte Verbindung nur für `prisma migrate` (bei Neon: die „Direct"-URL).
  // Lokal (Docker) identisch mit DATABASE_URL setzen.
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum NoteCategory {
  ARBEIT
  SCHULE
  URLAUB
  WOCHENENDE
}

enum TokenType {
  EMAIL_VERIFY // Double-Opt-in bei offener Selbst-Registrierung
  PASSWORD_RESET // Passwort-Vergessen-Flow
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(EMPLOYEE)
  active        Boolean   @default(true)
  // Zeitpunkt der E-Mail-Bestätigung; null = noch nicht bestätigt (Login gesperrt).
  // Eingeladene/Admin-angelegte/geseedete Konten gelten als bestätigt.
  emailVerified DateTime?
  image         String? // Profilbild als Data-URL (klein) oder null
  createdAt     DateTime  @default(now())

  timeEntries    TimeEntry[]
  assignments    Assignment[]
  notes          Note[]
  tripMembership TripMember?
  credentials    Credential[]
  tokens         Token[]
}

// Einmal-Token für E-Mail-Bestätigung und Passwort-Reset.
model Token {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime? // gesetzt beim Einlösen → verbraucht
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Postgres-basiertes Rate-Limit (kein Redis nötig; funktioniert auch serverless).
// Fixed-Window je key (z. B. "register:<ip>", "login:<email>").
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// WebAuthn/Passkey-Credential (Public Key des Geräts; Fingerabdruck bleibt lokal).
model Credential {
  id         String   @id // credentialID (base64url)
  userId     String
  publicKey  Bytes
  counter    Int
  transports String   @default("")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  color     String   @default("#3b82f6")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  timeEntries TimeEntry[]
  assignments Assignment[]
}

// Welche Projekte darf ein User buchen (optional; leer = alle aktiven Projekte).
model Assignment {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  // Reines Datum (ohne Uhrzeit) → tagesbasierte Erfassung, zeitzonenfeste Aggregation.
  date      DateTime @db.Date
  // Dauer in Minuten (Int) → keine Float-Rundungsfehler.
  minutes   Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // Trägt Daily/Monthly/Yearly-Queries.
  @@index([userId, date])
  @@index([projectId])
}

// Freitext-Notizen im Google-Keep-Stil, tagesbezogen. Kategorie färbt die Karte.
model Note {
  id        String       @id @default(cuid())
  userId    String
  // Tagesbezug wie bei TimeEntry (ohne Uhrzeit) → tagesbasierte Anzeige.
  date      DateTime     @db.Date
  content   String
  category  NoteCategory @default(ARBEIT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Japan-Reise: gemeinsamer Workspace (Trip) mit Mitgliedern ---
// Alle Japan-Tools gehören einer Reise; eingeladene Mitglieder bearbeiten sie gemeinsam.

model Trip {
  id        String   @id @default(cuid())
  name      String   @default("Japan-Reise")
  createdAt DateTime @default(now())

  members        TripMember[]
  tripStops      TripStop[]
  expenses       Expense[]
  flights        Flight[]
  plannerTasks   PlannerTask[]
  checklistItems ChecklistItem[]
  invitations    TripInvitation[]
}

// Einladung für eine Person OHNE Konto: Token-Link zum Selbst-Registrieren.
// Beim Einlösen entsteht ein User, der direkt Mitglied dieser Reise wird.
model TripInvitation {
  id         String    @id @default(cuid())
  tripId     String
  email      String // Ziel-E-Mail (lowercase), an die eingeladen wurde
  token      String    @unique // im Registrierungs-Link
  invitedBy  String // Name des Einladenden (Schnappschuss)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime // Gültigkeit (14 Tage)
  acceptedAt DateTime? // gesetzt, sobald eingelöst → Link verbraucht
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([email])
}

// Ein Nutzer ist in genau einer Reise (userId @unique).
model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String   @unique
  joinedAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Reiseplaner-Stopp. id ist client-generiert (stabil über PUT-Replace).
model TripStop {
  id            String @id
  tripId        String
  label         String
  lat           Float
  lng           Float
  position      Int
  createdByName String @default("")
  trip          Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

model Expense {
  id            String   @id @default(cuid())
  tripId        String
  category      String
  label         String
  yen           Int
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // Optional an einen Flug gekoppelt: der Flugpreis erscheint als Ausgabe und wird
  // beim Löschen des Flugs mitgelöscht (Cascade).
  flightId      String?  @unique
  flight        Flight?  @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Ein hinterlegter Flug (pro Reise, mit Mitgliedern geteilt). Details werden per
// Flugnummer automatisch befüllt (falls API-Key gesetzt) oder manuell eingegeben;
// der Preis (in Yen gespeichert) fließt als verknüpfte Ausgabe in den Rechner.
model Flight {
  id            String    @id @default(cuid())
  tripId        String
  flightNumber  String
  airline       String    @default("")
  fromCode      String    @default("") // IATA, z. B. FRA
  fromName      String    @default("")
  toCode        String    @default("") // IATA, z. B. HND
  toName        String    @default("")
  departure     DateTime? // Abflug (lokal, als Zeitpunkt)
  arrival       DateTime? // Ankunft
  bookingRef    String    @default("")
  priceYen      Int? // Preis in Yen (Eingabe €/¥ wird clientseitig umgerechnet)
  createdByName String    @default("")
  createdAt     DateTime  @default(now())
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense       Expense?

  @@index([tripId])
}

model PlannerTask {
  id            String   @id @default(cuid())
  tripId        String
  date          DateTime @db.Date
  time          String
  text          String
  done          Boolean  @default(false)
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
}

model ChecklistItem {
  id            String   @id @default(cuid())
  tripId        String
  text          String
  done          Boolean  @default(false)
  position      Int
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}
