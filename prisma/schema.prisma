// Prisma-Schema für den Time Tracker.
// Datenmodell laut Plan: User / Project / Assignment / TimeEntry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum NoteCategory {
  ARBEIT
  SCHULE
  URLAUB
  WOCHENENDE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  timeEntries    TimeEntry[]
  assignments    Assignment[]
  notes          Note[]
  tripMembership TripMember?
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  color     String   @default("#3b82f6")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  timeEntries TimeEntry[]
  assignments Assignment[]
}

// Welche Projekte darf ein User buchen (optional; leer = alle aktiven Projekte).
model Assignment {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  // Reines Datum (ohne Uhrzeit) → tagesbasierte Erfassung, zeitzonenfeste Aggregation.
  date      DateTime @db.Date
  // Dauer in Minuten (Int) → keine Float-Rundungsfehler.
  minutes   Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // Trägt Daily/Monthly/Yearly-Queries.
  @@index([userId, date])
  @@index([projectId])
}

// Freitext-Notizen im Google-Keep-Stil, tagesbezogen. Kategorie färbt die Karte.
model Note {
  id        String       @id @default(cuid())
  userId    String
  // Tagesbezug wie bei TimeEntry (ohne Uhrzeit) → tagesbasierte Anzeige.
  date      DateTime     @db.Date
  content   String
  category  NoteCategory @default(ARBEIT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Japan-Reise: gemeinsamer Workspace (Trip) mit Mitgliedern ---
// Alle Japan-Tools gehören einer Reise; eingeladene Mitglieder bearbeiten sie gemeinsam.

model Trip {
  id        String   @id @default(cuid())
  name      String   @default("Japan-Reise")
  createdAt DateTime @default(now())

  members        TripMember[]
  tripStops      TripStop[]
  expenses       Expense[]
  plannerTasks   PlannerTask[]
  checklistItems ChecklistItem[]
}

// Ein Nutzer ist in genau einer Reise (userId @unique).
model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String   @unique
  joinedAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Reiseplaner-Stopp. id ist client-generiert (stabil über PUT-Replace).
model TripStop {
  id       String @id
  tripId   String
  label    String
  lat      Float
  lng      Float
  position Int
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

model Expense {
  id        String   @id @default(cuid())
  tripId    String
  category  String
  label     String
  yen       Int
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model PlannerTask {
  id        String   @id @default(cuid())
  tripId    String
  date      DateTime @db.Date
  time      String
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  text      String
  done      Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}
