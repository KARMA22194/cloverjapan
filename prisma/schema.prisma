// Prisma-Schema für Clover Japan (kollaborativer Japan-Reiseplaner).
// Kern: User / Trip / TripMember / TripStop / TripHotel / Expense / Flight / …

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Laufzeit-Verbindung der App (bei Neon: die „Pooled"-URL).
  url      = env("DATABASE_URL")
  // Direkte Verbindung nur für `prisma migrate` (bei Neon: die „Direct"-URL).
  // Lokal (Docker) identisch mit DATABASE_URL setzen.
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFY // Double-Opt-in bei offener Selbst-Registrierung
  PASSWORD_RESET // Passwort-Vergessen-Flow
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(EMPLOYEE)
  active        Boolean   @default(true)
  // Zeitpunkt der E-Mail-Bestätigung; null = noch nicht bestätigt (Login gesperrt).
  // Eingeladene/Admin-angelegte/geseedete Konten gelten als bestätigt.
  emailVerified DateTime?
  image         String? // Profilbild als Data-URL (klein) oder null
  createdAt     DateTime  @default(now())

  tripMembership TripMember?
  credentials    Credential[]
  tokens         Token[]
  expensesPaid   Expense[]   @relation("ExpensePaidBy")
}

// Einmal-Token für E-Mail-Bestätigung und Passwort-Reset.
model Token {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime? // gesetzt beim Einlösen → verbraucht
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Postgres-basiertes Rate-Limit (kein Redis nötig; funktioniert auch serverless).
// Fixed-Window je key (z. B. "register:<ip>", "login:<email>").
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// WebAuthn/Passkey-Credential (Public Key des Geräts; Fingerabdruck bleibt lokal).
model Credential {
  id         String   @id // credentialID (base64url)
  userId     String
  publicKey  Bytes
  counter    Int
  transports String   @default("")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Japan-Reise: gemeinsamer Workspace (Trip) mit Mitgliedern ---
// Alle Japan-Tools gehören einer Reise; eingeladene Mitglieder bearbeiten sie gemeinsam.

model Trip {
  id        String   @id @default(cuid())
  name      String   @default("Japan-Reise")
  createdAt DateTime @default(now())

  members        TripMember[]
  tripStops      TripStop[]
  tripHotels     TripHotel[]
  expenses       Expense[]
  flights        Flight[]
  plannerTasks   PlannerTask[]
  checklistItems ChecklistItem[]
  invitations    TripInvitation[]
  settlements    Settlement[]
  bookings       Booking[]
  wishlist       WishlistItem[]
  activities     Activity[]
}

// Einladung für eine Person OHNE Konto: Token-Link zum Selbst-Registrieren.
// Beim Einlösen entsteht ein User, der direkt Mitglied dieser Reise wird.
model TripInvitation {
  id         String    @id @default(cuid())
  tripId     String
  email      String // Ziel-E-Mail (lowercase), an die eingeladen wurde
  token      String    @unique // im Registrierungs-Link
  invitedBy  String // Name des Einladenden (Schnappschuss)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime // Gültigkeit (14 Tage)
  acceptedAt DateTime? // gesetzt, sobald eingelöst → Link verbraucht
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([email])
}

// Ein Nutzer ist in genau einer Reise (userId @unique).
model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String   @unique
  joinedAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Reiseplaner-Stopp. id ist client-generiert (stabil über PUT-Replace).
model TripStop {
  id            String @id
  tripId        String
  label         String
  lat           Float
  lng           Float
  position      Int
  date          String? // optionaler Reisetag (YYYY-MM-DD) → Verknüpfung mit Tagesplaner
  createdByName String  @default("")
  trip          Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

// Unterkunft der Reise (Hotel/Ryokan). Eigenes Modell statt Stopp, damit Hotels
// nicht in die Routenoptimierung einfließen und auf der Karte eigen markiert sind.
// Mehrere möglich (z. B. je Stadt), mit optionalem Check-in/Check-out-Datum.
model TripHotel {
  id            String  @id @default(cuid())
  tripId        String
  label         String
  lat           Float
  lng           Float
  checkIn       String? // YYYY-MM-DD
  checkOut      String? // YYYY-MM-DD
  position      Int
  createdByName String  @default("")
  trip          Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

model Expense {
  id            String   @id @default(cuid())
  tripId        String
  category      String
  label         String
  yen           Int
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // Wer die Ausgabe bezahlt hat (für die Abrechnung). null = nicht zugeordnet
  // (z. B. Altbestand oder Zahler aus der Reise entfernt → SetNull).
  paidById      String?
  paidBy        User?    @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  // true = auf alle Mitglieder aufteilen; false = persönlich (nicht in die Abrechnung).
  shared        Boolean  @default(true)
  // Optionales Beleg-Foto als (verkleinerte) Data-URL.
  receipt       String?
  // Optional an einen Flug gekoppelt: der Flugpreis erscheint als Ausgabe und wird
  // beim Löschen des Flugs mitgelöscht (Cascade).
  flightId      String?  @unique
  flight        Flight?  @relation(fields: [flightId], references: [id], onDelete: Cascade)
  // Optional an eine Buchung gekoppelt (dito).
  bookingId     String?  @unique
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([paidById])
}

// Reservierung/Ticket mit Termin und Bestätigungsnummer (pro Reise geteilt).
// Optionaler Preis erzeugt eine gekoppelte Ausgabe (wie beim Flug).
model Booking {
  id            String   @id @default(cuid())
  tripId        String
  title         String
  kind          String   @default("TICKET") // TICKET | RESTAURANT | AKTIVITAET | TRANSPORT | SONSTIGES
  date          String? // YYYY-MM-DD (optional)
  time          String   @default("") // HH:MM (optional)
  ref           String   @default("") // Bestätigungs-/Buchungsnummer
  url           String   @default("")
  note          String   @default("")
  priceYen      Int?
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense       Expense?

  @@index([tripId])
}

// Ein hinterlegter Flug (pro Reise, mit Mitgliedern geteilt). Details werden per
// Flugnummer automatisch befüllt (falls API-Key gesetzt) oder manuell eingegeben;
// der Preis (in Yen gespeichert) fließt als verknüpfte Ausgabe in den Rechner.
model Flight {
  id            String    @id @default(cuid())
  tripId        String
  flightNumber  String
  airline       String    @default("")
  fromCode      String    @default("") // IATA, z. B. FRA
  fromName      String    @default("")
  toCode        String    @default("") // IATA, z. B. HND
  toName        String    @default("")
  departure     DateTime? // Abflug (lokale Wall-Clock, als UTC-naiv gespeichert)
  arrival       DateTime? // Ankunft (dito)
  durationMin   Int? // echte Flugdauer (aus UTC-Zeiten beim Abruf; manuell null)
  bookingRef    String    @default("")
  seats         String    @default("") // Sitzplätze, z. B. "32A, 32B"
  priceYen      Int? // Preis in Yen (Eingabe €/¥ wird clientseitig umgerechnet)
  createdByName String    @default("")
  createdAt     DateTime  @default(now())
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  expense       Expense?

  @@index([tripId])
}

model PlannerTask {
  id            String   @id @default(cuid())
  tripId        String
  date          DateTime @db.Date
  time          String
  text          String
  done          Boolean  @default(false)
  createdByName String   @default("")
  assigneeName  String   @default("") // zugewiesenes Mitglied (Namens-Schnappschuss)
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
}

// Verbuchte Zahlung zwischen zwei Mitgliedern (gleicht offene Salden aus).
// from zahlt to den Betrag → verringert deren Schuld in der Abrechnung.
// IDs + Namens-Schnappschuss (Datensatz bleibt stabil, auch wenn jemand die Reise verlässt).
model Settlement {
  id            String   @id @default(cuid())
  tripId        String
  fromId        String
  toId          String
  fromName      String   @default("")
  toName        String   @default("")
  yen           Int
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Einkaufs-/Souvenir-Wunschliste (pro Reise geteilt). Preis in Yen; Summe kann als
// Warenwert in den Zollrechner übernommen werden.
model WishlistItem {
  id            String   @id @default(cuid())
  tripId        String
  label         String
  priceYen      Int?
  bought        Boolean  @default(false)
  position      Int
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}

// Aktivitäts-Feed: menschenlesbare Ereignisse pro Reise (wer hat was hinzugefügt).
model Activity {
  id        String   @id @default(cuid())
  tripId    String
  userId    String? // Referenz auf den Auslöser (kein harter FK; Name ist Schnappschuss)
  userName  String   @default("")
  action    String // Maschinen-Schlüssel, z. B. "booking.create"
  summary   String // fertige Anzeige, z. B. "teamLab Planets"
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model ChecklistItem {
  id            String   @id @default(cuid())
  tripId        String
  text          String
  done          Boolean  @default(false)
  position      Int
  createdByName String   @default("")
  assigneeName  String   @default("") // zugewiesenes Mitglied (Namens-Schnappschuss)
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, position])
}
